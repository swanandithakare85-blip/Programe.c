#include <stdio.h>
void swap(int *a, int *b)
{
 int temp;
 temp = *a;
 *a = *b;
 *b = temp;
}
int main()
{
 int num1, num2; printf("Enter first number: ");
 scanf("%d", &num1);
 printf("Enter second number: ");
 scanf("%d", &num2);
 printf("\nBefore swapping:\n");
 printf("First number = %d\n", num1);
 printf("Second number = %d\n", num2);
 swap(&num1, &num2);
 printf("\nAfter swapping:\n");
 printf("First number = %d\n", num1);
 printf("Second number = %d\n", num2);
 return 0;
}




